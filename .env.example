# Server & Environment
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://artify_dev:CHANGE_ME@localhost:5432/artify_dev?schema=public
SESSION_SECRET=
WEBHOOK_SECRET=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
COOKIE_DOMAIN=
LOG_LEVEL=info

# AI Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Storage & Media Configuration
OBJECT_STORAGE_PROVIDER=none
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_SERVICE_ROLE_KEY=
LOCAL_STORAGE_DIR=.local-storage
MEDIA_MAX_IMAGE_SIZE_BYTES=10485760
MEDIA_MAX_DOCUMENT_SIZE_BYTES=26214400
MEDIA_SIGNED_URL_TTL_SECONDS=900
MEDIA_UPLOAD_SESSION_TTL_MINUTES=15

# Security & Session Tunables
SESSION_TTL_HOURS=24
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_MIN_LENGTH=10
INVITATION_TOKEN_TTL_HOURS=72

# Public Website & CMS
PUBLIC_WEBSITE_ORGANIZATION_ID=
